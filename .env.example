# Copia questo file con il nome .env.local e metti i valori del tuo progetto
# Supabase (pannello Supabase → bottone Connect). .env.local NON va su GitHub.
VITE_SUPABASE_URL=https://il-tuo-progetto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo per il link di prova su Cloudflare: mostra la fascia "Versione di prova".
# In locale puoi lasciarla vuota.
VITE_TEST_VERSION=
